# ==============================================================================
# AGENTOPS — Environment Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME=AGENTOPS
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=8800
POSTGRES_DB=agentops
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agentops

# ------------------------------------------------------------------------------
# Cache & Message Streaming Infrastructure
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AGENT_EVENTS_TOPIC=agentops.events

# ------------------------------------------------------------------------------
# Vector / Semantic RAG Configuration
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=mock   # "mock" for local deterministic dev, or "openai"
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ------------------------------------------------------------------------------
# LLM & Reasoning Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock        # "mock" for deterministic local evaluation, or "openai"
OPENAI_API_KEY=mock-dev-key-not-for-production
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# Agent Execution Policy & Guardrails
# ------------------------------------------------------------------------------
EXECUTION_POLICY=ASSISTED   # "ASSISTED" (human approval gates) or "AUTONOMOUS"
MAX_AGENT_ITERATIONS=10
MAX_TOOL_ITERATIONS=8
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Frontend Dashboard Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
